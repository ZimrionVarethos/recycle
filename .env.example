# Supabase Configuration
# Dapatkan kredensial ini dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY bersifat SERVER-ONLY, JANGAN pernah menambahkan prefix NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Machine Learning API Configuration (Python FastAPI / Gradio Backend)
# Kosongkan atau abaikan untuk menjalankan website dalam Mode Demo / Mock
ML_API_URL=https://your-ml-api.example.com
NEXT_PUBLIC_ML_API_URL=
